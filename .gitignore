# ── OS / editor ─────────────────────────────────────────────────────────
.DS_Store
*.log
*.swp
.history

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# ── Web app (web/) ──────────────────────────────────────────────────────
# The app is a fully static Next.js export: `next build` emits web/out/.
node_modules/
web/.next/
web/out/
web/next-env.d.ts
web/coverage/
web/*.tsbuildinfo
# Local env files (commit only *.example). The app itself needs no env — these
# stay as a guard against ever committing one.
.env
.env*.local
web/.env
web/.env*.local

# ── Local-only files (kept on disk, never tracked) ──────────────────────
# Reference paper + the 002 sample dataset. Scrubbed from git history and
# deliberately untracked; the golden test reads its own tracked copy at
# web/test/fixtures/spectro-002, so a fresh clone still passes.
materials/
# Manuscript reference material (the published ACS PDF) — local-only, like materials/
paper/resources/
.playwright-mcp/
