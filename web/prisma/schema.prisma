// Spectro Web — Prisma 7 schema (PostgreSQL).
//
// Two concerns live here:
//   1. Auth.js (NextAuth v5) with the Credentials provider + JWT sessions.
//      We store the user + a bcrypt password hash ourselves (no adapter), plus
//      a PasswordResetToken for self-service reset. There is no Account/Session/
//      VerificationToken table — JWT sessions are stateless and there is no
//      OAuth/magic-link.
//   2. The spectro domain — a port of mobile/lib/data/models/project.dart,
//      reframed as the two-device "Experiment" from web-refactor-plan.md §7.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // Prisma 7: the connection URL lives in prisma.config.ts (for Migrate) and is
  // passed to PrismaClient via the @prisma/adapter-pg driver adapter.
  provider = "postgresql"
}

// ── Auth (credentials + JWT) models ──────────────────────────────────────────

model User {
  id           String       @id @default(cuid())
  name         String?
  email        String       @unique
  image        String?
  /// bcrypt hash of the user's password (set at registration / reset).
  passwordHash String?
  experiments  Experiment[]
  resetTokens  PasswordResetToken[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

/// A single-use, time-limited password-reset token. We store only a hash of the
/// token (the raw value lives only in the emailed link), expire it after ~1h,
/// and delete it once consumed.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Spectro domain ───────────────────────────────────────────────────────────

enum ExperimentMode {
  beerLambert
  fluorescence
}

enum ReferenceLight {
  fluorescent
}

/// Which way the spectrum strip runs in the captured frame — the dispersion
/// (wavelength) axis. Horizontal averages down columns; vertical averages
/// across rows.
enum SpectrumOrientation {
  horizontal
  vertical
}

enum WorkflowStep {
  experimentSetup
  cameraRoiSetup
  calibration
  blank
  standards
  absorbanceReview
  unknown
  results
}

enum SpectralImageRole {
  calibration
  blank
  standard
  unknown
}

/// The shared two-device unit (laptop drives, phone captures). Owns pairing,
/// the current step, the ROI, the calibration, and every capture.
model Experiment {
  id        String         @id @default(cuid())
  name      String
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Up-front choices (web-refactor-plan.md §3 step 0)
  mode      ExperimentMode @default(beerLambert)
  lightType ReferenceLight @default(fluorescent)

  currentStep WorkflowStep @default(experimentSetup)

  // Phone pairing / capture choreography
  joinToken        String?   @unique
  joinTokenExpires DateTime?
  /// CaptureRequest that drives the phone, e.g.
  /// { type: 'standard', conc: 5, unit: 'mg/L', standardId: '...' }. Null when idle.
  pendingCapture   Json?

  // ROI in image coordinates: { left, top, width, height }. Null → full-frame
  // default (DEFAULT_ROI), preserved for pre-cropped strips.
  roi Json?

  // Which way the spectrum runs in the frame (set on the lamp image in L3.1).
  orientation SpectrumOrientation @default(horizontal)

  // Wavelength calibration (slope, intercept, rSquared, peaks[]) — stored as a
  // structured blob; derived, low-churn. Null until calibrated.
  calibration Json?

  // Chosen λmax (nm) for the Beer-Lambert curve. Null → auto-derived from the
  // highest-concentration standard; set when the student adjusts it.
  lambdaMax Float?

  // Persisted Beer-Lambert calibration curve (the derived result), written by
  // persistDerived after each capture/re-extract:
  //   { slope, intercept, rSquared, lambdaMax, dataPoints: [{x: conc, y: A}] }.
  // The wizard still recomputes from profiles for display (deriveAnalysis); this
  // is the durable record (export / report) — null until ≥2 usable standards.
  calibrationCurve Json?

  images    SpectralImage[]
  standards Standard[]
  unknowns  Unknown[]

  @@index([userId])
}

/// A captured frame plus its extracted 1-D intensity profile. The image binary
/// lives in object storage; we keep the URL + the profile (mirrors the Dart
/// SpectralImage.filePath + intensityProfile).
model SpectralImage {
  id           String            @id @default(cuid())
  experimentId String
  experiment   Experiment        @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  role         SpectralImageRole
  url          String
  capturedAt   DateTime          @default(now())
  /// IntensityProfile: { points: [{ x, y }, ...] }
  intensityProfile Json?

  // Back-relations for the role-specific records that point at this image.
  standard Standard?
  unknown  Unknown?

  @@index([experimentId])
}

/// A standard of known concentration. absorbanceSpectrum holds the computed
/// (wavelength, absorbance) points + λmax once analysed.
model Standard {
  id           String     @id @default(cuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  concentration Float
  unit          String

  imageId String?        @unique
  image   SpectralImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  /// AbsorbanceSpectrum: { points: [{x,y}], lambdaMax?, absorbanceAtLambdaMax? }
  absorbanceSpectrum Json?

  createdAt DateTime @default(now())

  @@index([experimentId])
}

/// The unknown sample and its back-calculated concentration.
model Unknown {
  id           String     @id @default(cuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  imageId String?        @unique
  image   SpectralImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)

  absorbanceSpectrum     Json?
  absorbanceAtLambdaMax  Float?
  determinedConcentration Float?

  createdAt DateTime @default(now())

  @@index([experimentId])
}
