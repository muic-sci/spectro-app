# ── Database (Prisma 7 / Postgres) ──────────────────────────────────────────
# Local dev: matches docker-compose.yml below (`docker compose up -d`).
DATABASE_URL="postgresql://spectro:spectro@localhost:5433/spectro?schema=public"

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-me"
# Public base URL of the web app (used for callback/magic-link URLs).
AUTH_URL="http://localhost:3000"

# Email magic-link sign-in (Nodemailer provider). Use a real SMTP server, or a
# dev inbox like Mailpit / Ethereal for local testing.
EMAIL_SERVER="smtp://user:pass@localhost:1025"
EMAIL_FROM="Spectro <no-reply@spectro.local>"

# ── Optional: Google OAuth (only enabled when both are set) ──────────────────
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
