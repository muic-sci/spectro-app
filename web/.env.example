# ── Database (Prisma 7 / Postgres) ──────────────────────────────────────────
# Local dev: matches docker-compose.yml below (`docker compose up -d`).
DATABASE_URL="postgresql://spectro:spectro@localhost:5433/spectro?schema=public"

# ── Auth.js (NextAuth v5) — email + password (Credentials provider, JWT) ─────
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-me"
# Public base URL of the web app (used for password-reset links).
AUTH_URL="http://localhost:3000"
# Trust the proxy's forwarded host/proto (required behind nginx-proxy in prod).
AUTH_TRUST_HOST=true

# ── Email (password reset only) ──────────────────────────────────────────────
# Login no longer uses email — these are used solely to send the password-reset
# link. Use a real SMTP server in prod, or a dev inbox like Mailpit locally
# (reset emails appear at http://localhost:8025).
EMAIL_SERVER="smtp://user:pass@localhost:1025"
EMAIL_FROM="Spectro <no-reply@spectro.local>"
