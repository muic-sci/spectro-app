# Spectro Web is a fully static, in-browser app — there is no server, database,
# auth or email, so there is essentially nothing to configure.
#
# Local dev:  npm run dev      (http://localhost:3000)
# Build:      npm run build    (static export → out/)
# Preview:    npm run preview  (serve the built out/ locally)

# Optional: a version label shown in the corner badge (CI sets this to the tag).
# NEXT_PUBLIC_APP_VERSION=dev
