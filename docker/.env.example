# Production env for docker/docker-compose.yml.
# Copy to `.env` ON THE SERVER and fill in. Keep `.env` OUT of the rsync (it is
# server-managed and holds secrets) — only this example is synced.
#
#   cp .env.example .env   # then edit, then: docker compose up -d

# ── Image (set by CI deploy / cron-deploy.sh) ────────────────────────────────
SPECTRO_APP_IMAGE=registry.gitlab.com/<group>/spectro-app:latest

# ── Postgres (the `db` service) ──────────────────────────────────────────────
# The app builds its connection string from these (src/lib/database-url.ts) and
# percent-encodes the credentials — so no separate DATABASE_URL, and special
# characters in the password are fine.
POSTGRES_USER=spectro
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=spectro
# POSTGRES_PORT=5432

# Host paths for persistent data (bind mounts). Relative paths resolve against
# the compose file's directory; use absolute paths to put data elsewhere. Both
# are created on first `up`. Back these two up.
POSTGRES_DATA_DIR=./pgdata
UPLOADS_DIR=./uploads
# In-container path the app writes uploads to (the bind-mount target). Rarely
# changed; defaults to /data/uploads.
# SPECTRO_STORAGE_DIR=/data/uploads

# ── Auth (email + password, JWT sessions) ────────────────────────────────────
# Generate: openssl rand -base64 33
AUTH_SECRET=change-me
# Public HTTPS URL of the app (used for password-reset links).
AUTH_URL=https://spectro.yourdomain.com

# ── Email (password reset only) ──────────────────────────────────────────────
# Real SMTP is required for self-service password reset to work.
EMAIL_SERVER=smtp://user:pass@smtp.yourprovider.com:587
EMAIL_FROM=Spectro <no-reply@yourdomain.com>

# ── Reverse proxy (nginx-proxy + acme-companion) routing/TLS ─────────────────
# The proxy network is NOT managed by compose — connect the app container to it
# manually (or set PROXY_NETWORK so cron-deploy.sh re-attaches it each release).
VIRTUAL_HOST=spectro.yourdomain.com
LETSENCRYPT_HOST=spectro.yourdomain.com
# Name of your existing reverse-proxy Docker network (e.g. nginx-docker). Leave
# blank to attach the proxy fully by hand.
PROXY_NETWORK=nginx-docker
