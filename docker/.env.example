# Copy this file to .env and fill in your values before running docker compose.
#
#   cp .env.example .env
#   docker compose up -d --build

# Domain that nginx-proxy will route to this container.
VIRTUAL_HOST=spectro.yourdomain.com

# Domain that acme-companion will issue a TLS certificate for (usually the same).
LETSENCRYPT_HOST=spectro.yourdomain.com
