# Production env for docker/docker-compose.yml (a static nginx site).
# Copy to `.env` ON THE SERVER and fill in. Keep `.env` OUT of the rsync (it is
# server-managed). The app is fully static — there is no database, auth or email,
# so the only settings are the image tag and the reverse-proxy routing.
#
#   cp .env.example .env   # then edit, then: docker compose up -d

# ── Image (set by CI deploy / cron-deploy.sh) ────────────────────────────────
SPECTRO_APP_IMAGE=registry.gitlab.com/<group>/spectro-app:latest

# ── Reverse proxy (nginx-proxy + acme-companion) routing/TLS ─────────────────
# The proxy is NOT managed by compose. cron-deploy.sh attaches your nginx-proxy
# CONTAINER to the app's network after each release (compose recreates that
# network on every up), so it can route to the app (served on :80).
VIRTUAL_HOST=spectro.yourdomain.com
LETSENCRYPT_HOST=spectro.yourdomain.com
# Your existing nginx-proxy CONTAINER name. Leave blank to wire the proxy by hand.
PROXY_CONTAINER=nginx-proxy
